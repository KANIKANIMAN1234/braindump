# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Phase 1 以降: マルチテナント API は service_role 推奨
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# LINE LIFF（招待 URL 生成にも使用）
LIFF_ID=2010175951-S9r18QtA

# 運営コンソール（super_admin）
PLATFORM_ADMIN_SECRET=your-long-random-secret
# 初期: full（全テナント参照可） / 本番: metadata_only
PLATFORM_DATA_ACCESS=full

# Dropbox（気づきCSVエクスポート）
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# アップロード先フォルダ（Dropbox API パス）。共有フォルダ「insights」を Dropbox に追加したうえで指定
# https://www.dropbox.com/scl/fo/llc8p0na8vhl1gkc5okg2/ABIWnPBXZ6Oh05O_TT7q4Fo?rlkey=hpkojr66qqyjh2151wwp39qw9&dl=0
DROPBOX_EXPORT_PATH=/insights
